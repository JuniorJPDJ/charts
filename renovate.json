{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":semanticCommitScopeDisabled",
    "docker:enableMajor",
    "customManagers:helmChartYamlAppVersions",
    ":disableRateLimiting",
    ":ignoreUnstable",
    ":separateMultipleMajorReleases",
    ":updateNotScheduled"
  ],
  "timezone": "Europe/Warsaw",
  "packageRules": [
    {
      "description": "Treat every chart as separate group with separate scope and branch prefix",
      "matchFileNames": [
        "charts/*/*"
      ],
      "additionalBranchPrefix": "{{parentDir}}-",
      "semanticCommitScope": "{{parentDir}}"
    },
    {
      "description": "Use correct versioning scheme for my containers",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/juniorjpdj/containers/**"
      ],
      "allowedVersions": "/^[\\d.]+-r\\d+$/",
      "versioning": "loose"
    },
    {
      "description": "searxng: loose versioning for date-based tags with git hash suffix, update only on Tuesday and Friday",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/searxng/searxng"
      ],
      "versioning": "loose",
      "schedule": [
        "* 5-8 * * 2,5"
      ]
    },
    {
      "description": "Disable digest pinning for regex managers in Chart.yaml used for appVersion upgrading",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "charts/*/Chart.yaml"
      ],
      "pinDigests": false
    },
    {
      "description": "Bump chart version on any update inside a chart. Pre-1.0 charts use the 0.x convention (major dep update -> minor chart bump, everything else -> patch); stable charts (>=1.0.0) mirror the update level (major/minor, else patch).",
      "matchFileNames": [
        "charts/*/*"
      ],
      "bumpVersions": [
        {
          "name": "bump-chart-version-pre1.0",
          "filePatterns": [
            "{{packageFileDir}}/Chart.yaml"
          ],
          "matchStrings": [
            "\\nversion:\\s*[\"']?(?<version>0\\.\\d+\\.\\d+)[\"']?"
          ],
          "bumpType": "{{#if isMajor}}minor{{else}}patch{{/if}}"
        },
        {
          "name": "bump-chart-version-stable",
          "filePatterns": [
            "{{packageFileDir}}/Chart.yaml"
          ],
          "matchStrings": [
            "\\nversion:\\s*[\"']?(?<version>[1-9]\\d*\\.\\d+\\.\\d+)[\"']?"
          ],
          "bumpType": "{{#if isMajor}}major{{else}}{{#if isMinor}}minor{{else}}patch{{/if}}{{/if}}"
        }
      ]
    },
    {
      "description": "archisteamfarm: versions come from GitHub releases (ghcr.io tags don't carry the GitHub pre-release flag, which made :ignoreUnstable useless here)",
      "matchManagers": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/justarchinet/archisteamfarm"
      ],
      "enabled": false
    },
    {
      "description": "archisteamfarm: Re-pin the image digest after Renovate drops it from the archisteamfarm image tag",
      "matchFileNames": [
        "charts/archisteamfarm/values.yaml"
      ],
      "postUpgradeTasks": {
        "commands": [
          "node scripts/sync-image-digest.js '{{{parentDir}}}'"
        ],
        "fileFilters": [
          "charts/*/*"
        ],
        "executionMode": "branch"
      }
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update appVersion in Chart.yaml from a dependency selected via a custom datasource",
      "managerFilePatterns": [
        "/(^|/)Chart\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-zA-Z0-9._-]+?)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*appVersion:\\s*[\"']?(?<currentValue>[\\w+.-]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}loose{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update the image tag in values.yaml from a dependency selected via a custom datasource",
      "managerFilePatterns": [
        "/(^|/)values\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-zA-Z0-9._-]+?)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*tag:\\s*[\"']?(?<currentValue>[\\w+.-]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?"
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}{{#if versioning}} versioning={{{versioning}}}{{/if}}\n  tag: \"{{{newVersion}}}\""
    }
  ]
}
