{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":semanticCommitScopeDisabled",
    "docker:enableMajor",
    "customManagers:helmChartYamlAppVersions",
    ":disableRateLimiting",
    ":ignoreUnstable",
    ":separateMultipleMajorReleases",
    ":updateNotScheduled"
  ],
  "packageRules": [
    {
      "description": "Treat every chart as separate group with separate scope and branch prefix",
      "matchFileNames": [
        "charts/*/*"
      ],
      "additionalBranchPrefix": "{{parentDir}}-",
      "semanticCommitScope": "{{parentDir}}"
    },
    {
      "description": "Use correct versioning scheme for my containers",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/juniorjpdj/containers/**"
      ],
      "allowedVersions": "/^[\\d.]+-r\\d+$/",
      "versioning": "loose"
    },
    {
      "description": "Use loose versioning for searxng date-based tags with git hash suffix and update only on Friday",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/searxng/searxng"
      ],
      "versioning": "loose",
      "schedule": [
        "* 5-9 * * 5"
      ]
    },
    {
      "description": "Disable digest pinning for regex managers in Chart.yaml used for appVersion upgrading",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "charts/*/Chart.yaml"
      ],
      "pinDigests": false
    },
    {
      "description": "Bump helm chart versions by a patch. This can be removed when https://github.com/renovatebot/renovate/issues/8231 is implemented and enabled.",
      "matchFileNames": [
        "charts/*/*"
      ],
      "postUpgradeTasks": {
        "commands": [
          "bash scripts/bump-chart-version.sh '{{{parentDir}}}'"
        ],
        "fileFilters": [
          "charts/*/*"
        ],
        "executionMode": "branch"
      }
    },
    {
      "description": "ArchiSteamFarm versions come from GitHub releases (ghcr.io tags don't carry the GitHub pre-release flag, which made :ignoreUnstable useless here)",
      "matchManagers": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/justarchinet/archisteamfarm"
      ],
      "enabled": false
    },
    {
      "description": "Re-pin the image digest after Renovate drops it from the archisteamfarm image tag, then bump the chart version",
      "matchFileNames": [
        "charts/archisteamfarm/values.yaml"
      ],
      "postUpgradeTasks": {
        "commands": [
          "node scripts/sync-image-digest.js '{{{parentDir}}}'",
          "bash scripts/bump-chart-version.sh '{{{parentDir}}}'"
        ],
        "fileFilters": [
          "charts/*/*"
        ],
        "executionMode": "branch"
      }
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update appVersion in Chart.yaml from a dependency selected via a custom datasource",
      "managerFilePatterns": [
        "/(^|/)Chart\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-zA-Z0-9._-]+?)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*appVersion:\\s*[\"']?(?<currentValue>[\\w+.-]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}loose{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update the image tag in values.yaml from a dependency selected via a custom datasource",
      "managerFilePatterns": [
        "/(^|/)values\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-zA-Z0-9._-]+?)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*tag:\\s*[\"']?(?<currentValue>[\\w+.-]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?"
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}{{#if versioning}} versioning={{{versioning}}}{{/if}}\n  tag: \"{{{newVersion}}}\""
    }
  ]
}
